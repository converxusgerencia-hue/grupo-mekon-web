---
import { navItems, site } from '../data/site';
---

<header class="site-header">
  <div class="topbar">
    <div class="shell topbar-inner">
      <span>Diseño, ingeniería, metalmecánica y construcción civil</span>
      <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>
    </div>
  </div>
  <div class="shell nav-wrap">
    <a class="brand" href="/" aria-label="Ir al inicio de Mekon">
      <img src="/images/logo-mekon.png" alt="Mekon e Ingeniería S.A.S." width="205" height="62" />
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      <ul class="desktop-nav">
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <details class="mobile-nav">
        <summary aria-label="Abrir menú"><span class="menu-toggle-icon" aria-hidden="true"></span><span>Menú</span></summary>
        <div class="mobile-panel">
          <ul>
            {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
          <a class="mobile-proposal" href="/contacto/">Solicitar propuesta</a>
        </div>
      </details>
    </nav>
    <a class="header-cta" href="/contacto/">Solicitar propuesta</a>
  </div>
</header>
