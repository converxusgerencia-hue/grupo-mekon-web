---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
---

<BaseLayout title={`${service.title} | Mekon e Ingeniería S.A.S.`} description={service.summary} image={service.gallery[0].src}>
  <section class="page-hero"><div class="shell"><p class="breadcrumb"><a href="/">Inicio</a> / <a href="/servicios/">Servicios</a> / {service.title}</p><p class="eyebrow">Línea de servicio</p><h1>{service.title}</h1><p>{service.summary}</p></div></section>
  <section class="section"><div class="shell detail-layout"><div><img src={service.gallery[0].src} alt={service.gallery[0].alt} style="width:100%;height:420px;object-fit:cover" /><p class="eyebrow" style="margin-top:34px">Alcance técnico</p><h2>Capacidad orientada a condiciones reales de proyecto.</h2><p class="body-copy">Mekon estructura esta línea de servicio desde la revisión de alcance, definición de recursos, programación y coordinación de actividades de campo. El objetivo es entregar una solución ejecutable, trazable y compatible con la operación del activo.</p><ul class="service-list">{service.items.map((item) => <li>{item}</li>)}</ul></div><aside class="aside-card"><p class="eyebrow">Contacto</p><h2>¿Necesita evaluar este servicio?</h2><p>Comparta la información disponible del activo, la ubicación y las condiciones de operación. El equipo comercial orientará el siguiente paso.</p><a class="button primary" href="/contacto/">Solicitar propuesta</a><a class="text-link" href="/servicios/">Volver a servicios <span>&rarr;</span></a></aside></div></section>
  <section class="section mist"><div class="shell"><div class="section-head"><div><p class="eyebrow">Evidencia de ejecución</p><h2>Aplicaciones en campo de esta especialidad.</h2></div><p>Imágenes de referencia de frentes de trabajo, equipos y actividades relacionadas con esta línea de servicio.</p></div><div class="application-gallery">{service.gallery.map((item) => <figure><img src={item.src} alt={item.alt} loading="lazy" /><figcaption>{item.alt}</figcaption></figure>)}</div></div></section>
</BaseLayout>
