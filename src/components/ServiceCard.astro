---
import type { services } from '../data/site';

interface Props {
  service: (typeof services)[number];
  featured?: boolean;
}

const { service, featured = false } = Astro.props;
---

<article class:list={['service-card', { featured }]}>
  <div class="service-image">
    <img src={service.gallery[0].src} alt={service.gallery[0].alt} loading="lazy" />
  </div>
  <div class="service-card-content">
    <span class="service-number">{service.number}</span>
    <h3>{service.title}</h3>
    <p>{service.short}</p>
    <a href={`/servicios/${service.slug}/`}>Ver servicio <span>&rarr;</span></a>
  </div>
</article>
