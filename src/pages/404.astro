---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada | Mekon e Ingeniería S.A.S." description="La página solicitada no se encuentra disponible.">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Error 404</p>
      <h1>La página solicitada no está disponible.</h1>
      <p>Puede volver al inicio o explorar nuestras líneas de servicio.</p>
      <div class="hero-actions">
        <a class="button primary" href="/">Ir al inicio</a>
        <a class="button secondary" href="/servicios/">Ver servicios</a>
      </div>
    </div>
  </section>
</BaseLayout>
