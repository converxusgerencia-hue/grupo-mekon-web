---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { civilWorks, rentalEquipment, services, structuralWorks } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
---

<BaseLayout title={`${service.title} | Mekon e Ingeniería S.A.S.`} description={service.summary} image={service.gallery[0].src}>
  <section class="page-hero"><div class="shell"><p class="breadcrumb"><a href="/">Inicio</a> / <a href="/servicios/">Servicios</a> / {service.title}</p><p class="eyebrow">Línea de servicio</p><h1>{service.title}</h1><p>{service.summary}</p></div></section>
  <section class="section"><div class="shell detail-layout"><div><img src={service.gallery[0].src} alt={service.gallery[0].alt} style="width:100%;height:420px;object-fit:cover" /><p class="eyebrow" style="margin-top:34px">Alcance técnico</p><h2>Capacidad orientada a condiciones reales de proyecto.</h2><p class="body-copy">Mekon estructura esta línea de servicio desde la revisión de alcance, definición de recursos, programación y coordinación de actividades de campo. El objetivo es entregar una solución ejecutable, trazable y compatible con la operación del activo.</p><ul class="service-list">{service.items.map((item) => <li>{item}</li>)}</ul></div><aside class="aside-card"><p class="eyebrow">Contacto</p><h2>¿Necesita evaluar este servicio?</h2><p>Comparta la información disponible del activo, la ubicación y las condiciones de operación. El equipo comercial orientará el siguiente paso.</p><a class="button primary" href="/contacto/">Solicitar propuesta</a><a class="text-link" href="/servicios/">Volver a servicios <span>&rarr;</span></a></aside></div></section>
  {service.slug === 'alquiler-de-equipos' && (
    <section class="section rental-section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Equipos disponibles</p><h2>Alternativas para frentes operativos y necesidades de apoyo temporal.</h2></div><p>Disponibilidad sujeta a programación, revisión de alcance y condiciones de movilización del proyecto.</p></div><div class="rental-grid">{rentalEquipment.map((equipment) => <article class="rental-card"><img src={equipment.image} alt={equipment.alt} loading="lazy" /><div><h3>{equipment.title}</h3><p>{equipment.description}</p></div></article>)}</div></div></section>
  )}
  {service.slug === 'infraestructura-civil' && (
    <section class="section civil-works-section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Obras ejecutadas</p><h2>Infraestructura civil con control de alcance, seguridad y condiciones de operación.</h2></div><p>Frentes de trabajo desarrollados para instalaciones industriales, almacenamiento y operación logística.</p></div><div class="civil-works-grid">{civilWorks.map((work) => <article class="civil-work-card"><img src={work.image} alt={work.alt} loading="lazy" /><div><h3>{work.title}</h3><p>{work.description}</p></div></article>)}</div></div></section>
  )}
  {service.slug === 'estructuras-y-fabricaciones' && (
    <section class="section structural-works-section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Estructuras ejecutadas</p><h2>Fabricación y montaje para procesos, equipos e infraestructura industrial.</h2></div><p>Aplicaciones desarrolladas con atención a accesibilidad, soportación, operación y condiciones de campo.</p></div><div class="structural-works-grid">{structuralWorks.map((work) => <article class="structural-work-card"><img src={work.image} alt={work.alt} loading="lazy" /><div><h3>{work.title}</h3><p>{work.description}</p></div></article>)}</div></div></section>
  )}
  <section class="section mist"><div class="shell"><div class="section-head"><div><p class="eyebrow">Evidencia de ejecución</p><h2>Aplicaciones en campo de esta especialidad.</h2></div><p>Imágenes de referencia de frentes de trabajo, equipos y actividades relacionadas con esta línea de servicio.</p></div><div class="application-gallery">{service.gallery.map((item) => <figure><img src={item.src} alt={item.alt} loading="lazy" /><figcaption>{item.alt}</figcaption></figure>)}</div></div></section>
</BaseLayout>
