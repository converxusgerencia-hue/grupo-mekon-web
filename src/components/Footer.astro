---
import { locations, navItems, site } from '../data/site';
---

<footer class="site-footer">
  <div class="footer-backdrop"></div>
  <div class="shell footer-grid">
    <section class="footer-brand">
      <img src="/images/logo-mekon.png" alt="Mekon e Ingeniería S.A.S." width="220" height="67" loading="lazy" />
      <p>Ingeniería aplicada para proyectos industriales con exigencias reales de seguridad, calidad y continuidad operativa.</p>
      <div class="social-links" aria-label="Redes sociales">
        <a href="https://www.instagram.com/grupomekon/" target="_blank" rel="noreferrer">Instagram</a>
        <a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </section>
    <section>
      <h2>Enlaces rápidos</h2>
      <ul class="footer-links">
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </section>
    <section class="footer-contact">
      <h2>Contacto</h2>
      <div class="locations">
        {locations.map((location) => (
          <div>
            <strong>{location.city}</strong>
            <span>{location.address}</span>
          </div>
        ))}
      </div>
      <a href={`mailto:${site.commercialEmail}`}>{site.commercialEmail}</a>
      <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>
    </section>
  </div>
  <div class="shell footer-bottom">
    <span>&copy; {new Date().getFullYear()} Mekon e Ingeniería S.A.S. Todos los derechos reservados.</span>
    <a href={site.whatsapp} target="_blank" rel="noreferrer">Atención por WhatsApp</a>
  </div>
</footer>
