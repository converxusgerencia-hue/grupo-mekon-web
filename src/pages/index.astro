---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { clients, projects, services } from '../data/site';
---

<BaseLayout title="Mekon e Ingeniería S.A.S. | Soluciones industriales" description="Ingeniería, montaje, metalmecánica, infraestructura civil e integridad de activos para operaciones industriales.">
  <section class="hero" style="background-image:url('/images/projects/plant-aerial-hero.jpg')"><div class="shell hero-content"><p class="eyebrow light">Mekon e Ingeniería S.A.S. &middot; Desde 2011</p><h1>Ingeniería que convierte alcance técnico en ejecución confiable.</h1><p>Desarrollamos proyectos de diseño, fabricación, montaje, obra civil e integridad de activos para instalaciones industriales con exigencias reales de seguridad, calidad y continuidad operativa.</p><div class="hero-actions"><a class="button primary" href="/servicios/">Explorar servicios</a><a class="button secondary" href="/contacto/">Solicitar propuesta</a></div><div class="hero-stats"><div><strong>Desde 2011</strong><span>Experiencia en ejecución industrial</span></div><div><strong>API / ASME / FM</strong><span>Criterio técnico aplicable</span></div><div><strong>HSEQ</strong><span>Gestión de seguridad y calidad</span></div><div><strong>Colombia y Perú</strong><span>Cobertura de proyectos</span></div></div></div></section>
  <section class="section"><div class="shell split"><div class="split-media"><img src="/images/projects/loading-manifold-wide.jpg" alt="Sistema industrial de transferencia de fluidos" /><div class="info-block"><strong>Alcance integral</strong><span>Ingeniería, suministro, ejecución y soporte en una misma coordinación técnica.</span></div></div><div><p class="eyebrow">Empresa</p><h2>Capacidad para intervenir activos y proyectos industriales.</h2><p class="body-copy">Mekon e Ingeniería S.A.S. atiende requerimientos de los sectores metalmecánico, oil & gas, construcción civil, suministros industriales y servicios especializados. Cada frente se organiza desde la definición del alcance hasta la entrega de evidencias técnicas.</p><div class="check-list"><span>Planeación de obra</span><span>Fabricación controlada</span><span>Montaje especializado</span><span>Soporte operativo</span></div><a class="text-link" href="/empresa/">Conocer la empresa <span>&rarr;</span></a></div></div></section>
  <section class="section mist"><div class="shell"><div class="section-head"><div><p class="eyebrow">Servicios</p><h2>Especialidades para la infraestructura que mantiene una operación en movimiento.</h2></div><p>Las líneas de servicio se presentan como capacidades independientes, con alcance y aplicaciones claras para facilitar la evaluación técnica de cada requerimiento.</p></div><div class="service-grid">{services.map((service) => <ServiceCard service={service} />)}</div></div></section>
  <section class="dark-band"><div class="shell dark-grid"><div><p class="eyebrow light">Integridad de activos</p><h2>Control técnico sobre corrosión, recubrimientos e información de campo.</h2><p>Soluciones orientadas a extender la vida útil de la infraestructura metálica, anticipar deterioros y sustentar decisiones de mantenimiento.</p><a class="button secondary" href="/integridad-de-activos/">Ver capacidades de integridad</a></div><div class="tag-grid"><span>Sistemas ICCP</span><span>Ánodos galvánicos</span><span>Monitoreo y telemetría</span><span>Inspección CIPS/DCVG</span><span>Diagnóstico de potenciales</span><span>Recubrimientos industriales</span></div></div></section>
  <section class="section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Proyectos</p><h2>Evidencia de ejecución en campo.</h2></div><p>Una selección de frentes que representa el tipo de soluciones que Mekon coordina para instalaciones industriales y de almacenamiento.</p></div><div class="project-grid">{projects.map((project) => <article class="project-card"><img src={project.image} alt={project.alt} loading="lazy" /><div><span>{project.category}</span><h3>{project.title}</h3><p>{project.text}</p></div></article>)}</div><a class="text-link" href="/proyectos/">Ver portafolio de proyectos <span>&rarr;</span></a></div></section>
  <section class="section mist"><div class="shell"><p class="eyebrow">Referencias</p><h2>Organizaciones que han confiado en nuestra capacidad de ejecución.</h2><div class="logo-grid">{clients.map((client) => <div class="client-logo"><img src={client.logo} alt={client.name} loading="lazy" /></div>)}</div><a class="text-link" href="/referencias/">Ver referencias <span>&rarr;</span></a></div></section>
  <section class="cta-band"><div class="shell"><div><p class="eyebrow light">Contacto comercial</p><h2>Conversemos sobre el alcance técnico de su próximo proyecto.</h2></div><a class="button" href="/contacto/">Contactar a Mekon</a></div></section>
  <section class="assurance-band"><div class="shell"><div><p class="eyebrow">Certificación Trinorma</p><h2>Sistema integrado de gestión para una ejecución controlada.</h2><p>Calidad, gestión ambiental y seguridad y salud en el trabajo como parte del control de cada proyecto.</p></div><div class="assurance-grid"><article><span>ISO</span><strong>9001</strong><small>Gestión de la calidad</small></article><article><span>ISO</span><strong>14001</strong><small>Gestión ambiental</small></article><article><span>ISO</span><strong>45001</strong><small>Seguridad y salud en el trabajo</small></article></div></div></section>
</BaseLayout>
